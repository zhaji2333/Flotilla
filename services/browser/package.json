    "lint": "oxlint src/"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
