{
  "name": "flotilla",
  "version": "0.0.0",
  "private": true,
  "description": "Flotilla — autonomous security research platform for explicitly authorized testing",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.9 <26"
  },
  "scripts": {
    "lint": "pnpm --recursive --if-present run lint",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test:packages": "pnpm --recursive --if-present run test",
    "test": "pnpm run test:packages",
    "build": "pnpm --recursive --if-present run build",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build",
    "verify:kb": "python3 tools/kb_index.py --check"
  },
  "devDependencies": {
    "oxlint": "^1.15.0"
  }
}
