# Frontend development environment (copy to .env.local; never commit a real token).
# Dev-only: the SPA attaches this bearer to fetch/SSE. Production bundles ignore
# VITE_API_TOKEN; nginx injects the real Authorization header server-side.
VITE_API_BASE_URL=
VITE_DEV_API_PROXY=http://127.0.0.1:3001
VITE_API_TOKEN=dev-admin-token
