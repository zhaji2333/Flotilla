{
  "name": "@src-agent/browser-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Isolated Playwright browser capability service for SRC-Agent",
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "dev": "node --import tsx src/server.ts",
