# SRC-Agent environment configuration
# Copy to .env and fill in values. This template must never contain real
# credentials; .env is git-ignored.

# ── LLM provider (worker model) ─────────────────────────────
# The worker calls an OpenAI-compatible endpoint (Chat Completions) through the
# audited proxy. DeepSeek, OpenAI, vLLM and most gateways can be used by only
# changing base URL and model.
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
# Name of the env var that holds the key (default LLM_API_KEY).
LLM_API_KEY_ENV=LLM_API_KEY
# Reasoning effort: none | low | high | max (applied only when the gateway is
# declared below; otherwise the model's default applies)
LLM_REASONING_EFFORT=max
# Optional gateway compatibility switches for pi-ai.
# DeepSeek OpenAI-compatible endpoint with thinking mode (enabled by default):
LLM_COMPAT_JSON={"thinkingFormat":"deepseek"}
LLM_REASONING_EFFORTS_JSON={"off":"none","high":"high","max":"max"}
LLM_MAX_OUTPUT_TOKENS=393216
# Declared model context window (drives Harness compaction; default 1M)
LLM_CONTEXT_WINDOW=1000000

# ── PostgreSQL ──────────────────────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_DB=srcagent
PG_USER=srcagent
PG_PASSWORD=srcagent_dev

# ── Worker budget defaults ──────────────────────────────────
# Safety limits adopted from ARTEX: 0 = unlimited.
# max_turns default 0 (unlimited); single-run wall clock default 1200s (20 min).
TASK_MAX_STEPS=0
TASK_MAX_WALL_CLOCK_MS=1200000
# Transient-retry policy (superagent-style): total attempts and base backoff.
WORKER_TRANSIENT_TRIES=3
WORKER_RETRY_BASE_MS=15000

# ── Egress proxy ────────────────────────────────────────────
PROXY_URL=http://proxy:8080
# Internet-retrieval egress allowlist (model API + web.fetch reference material).
# Target traffic is authorized separately by the active mission grant in DB.
INTERNET_ALLOWLIST=api.deepseek.com,example.com

# ── Build mirrors (optional; use a local mirror when the upstream is slow) ──
# APT_MIRROR=mirrors.ustc.edu.cn
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com

# P1-β Planner (opt-in compose profile: docker compose --profile planner up -d).
# Signals are batched: a reason pass starts only after a pending signal is older
# than the debounce window. The single-writer lease guards concurrent planners.
PLANNER_DEBOUNCE_MS=5000
PLANNER_LEASE_MS=300000

# H6a chunked resume: split one long worker run into step-bounded segments that
# resume the same Harness session and inject fresh hints at each boundary.
SRC_AGENT_CHUNK_STEPS=0
SRC_AGENT_CHUNK_MAX=8

# P1-gamma deterministic watchdog (duplicate URLs / denial spikes / no progress).
WATCHDOG_ENABLED=1
WATCHDOG_INTERVAL_MS=60000
WATCHDOG_WINDOW_MINUTES=10
WATCHDOG_DUPLICATE_THRESHOLD=10
WATCHDOG_NO_PROGRESS_MINUTES=15
WATCHDOG_MAX_OBSERVATIONS=20
# ADR-0039: consecutive stall observations before escalating to planner + human review.
WATCHDOG_ESCALATE_AFTER=2
# How long after a hint the sweep checks for new findings/new target URLs.
WATCHDOG_OUTCOME_DELAY_MS=600000
# Same-rule hint dedupe window.
WATCHDOG_DEDUPE_MINUTES=30
WATCHDOG_LLM_ENABLED=1
WATCHDOG_LLM_INTERVAL_MS=300000
WATCHDOG_MODEL_ROUTE=default
WATCHDOG_MODEL=deepseek-flash

# Worker request dedupe TTL (dispatcher env fallback; runtime setting
# worker.requestDedupeTtlMinutes takes precedence).
REQUEST_DEDUPE_TTL_MINUTES=30

# H6b runtime: cli (default one-shot subprocess) or inprocess (embedded DSH
# runtime; enables mid-run agent.steer() from the hint queue).
SRC_AGENT_RUNTIME=cli

# Egress mode (temporary): scope = target scope + internet allowlist enforced
# (default, safe); open = EVERY destination is forwarded/audited so lab work
# never fights the proxy. Open mode is explicitly temporary; the policy layer
# replaces it later. Do not leave open mode on for production.
EGRESS_MODE=scope

# Time display: containers and the console use Asia/Shanghai by default.
TZ=Asia/Shanghai
CONSOLE_TIME_ZONE=Asia/Shanghai

# Target traffic User-Agent: random browser UA by default. Set UA_MODE=fixed
# plus UA_FIXED for deterministic tests.
SRC_AGENT_UA_MODE=random

# P2 policy egress mode: EGRESS_MODE=policy keeps the target grant/internet
# allowlist checks and adds a per-host per-minute request ceiling.
# POLICY_RATE_LIMIT_PER_MIN=0 disables the ceiling.
POLICY_RATE_LIMIT_PER_MIN=120

# P3-A5: per-hop upstream response-header timeout for the egress proxy. Each
# redirect hop is a separate audited exchange, so this bounds a stalled hop.
PROXY_RESPONSE_HEADER_TIMEOUT_MS=60000

# P3-A1: inject a bounded prior-work digest from other tasks of the same
# mission at each claim boundary. Disable with PRIOR_WORK_ENABLED=0; the digest
# is capped at PRIOR_WORK_MAX_CHARS and at most PRIOR_WORK_TASK_LIMIT tasks.
PRIOR_WORK_ENABLED=1
PRIOR_WORK_MAX_CHARS=1500
PRIOR_WORK_TASK_LIMIT=6

# P3-B1/M5: typed blackboard frontier injection into the Planner snapshot.
# M5 revised defaults it on; set PLANNER_FRONTIER_ENABLED=0 for an A/B control.
# Blackboard credential facts are stored in plaintext per explicit user decision
# (ADR-0010); the Planner prompt marks them sensitive when injection is enabled
# and the console should mask them by default.
PLANNER_FRONTIER_FACT_LIMIT=20
PLANNER_FRONTIER_INTENT_LIMIT=20

# Skill effect evaluation control group: SRC_AGENT_SKILLS_ENABLED=0 removes the
# CkSKILLS catalog, the skill tool and the SKILLS prompt section (default 1).
SRC_AGENT_SKILLS_ENABLED=1

# Standalone API (packages/api) auth/CORS. API_AUTH_TOKEN is a bearer token for
# all /api routes except /api/health; CORS_ORIGINS is the comma-separated SPA
# origin allowlist. Change the dev default before exposing anything.
API_AUTH_TOKEN=dev-admin-token
# Worker-only read token: mission/trace GETs, never approval decisions or model config.
API_READ_TOKEN=dev-read-token
# accounts = human session login (default). The API seeds a single admin on
# first start (admin / admin123, must change on first login). "legacy" keeps the
# old service-token-only behavior.
AUTH_MODE=accounts
# Bootstrap admin; the password is only valid until the first login changes it.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
AUTH_SESSION_TTL_SECONDS=604800
# Set to 1 only behind HTTPS.
AUTH_COOKIE_SECURE=0
# Empty = real login: the SPA authenticates with the session cookie and nginx
# never injects a service token. Set a bearer value only to restore the old
# legacy behavior (every browser request becomes admin; not recommended).
API_LEGACY_TOKEN=

# P3-B2: admin token for UI model configuration (create/update/delete/reveal).
# Empty means the regular API token also acts as admin (dev-only fallback).
# Model API keys are stored in PostgreSQL in PLAINTEXT by explicit user decision
# (ADR-0011); only this admin token can reveal them, every reveal is audited.
API_ADMIN_TOKEN=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Independent execution plane.
EXECUTOR_URL=http://executor:9100
EXECUTOR_TOKEN=dev-executor-token
EXECUTOR_REPLICAS=2
# Dispatcher-only controller. Worker has no PG_* env/network.
DISPATCHER_URL=http://dispatcher:9300
DISPATCHER_TOKEN=dev-dispatcher-token
DISPATCHER_TIMEOUT_MS=120000
# Internal model proxy. Provider keys stay in API; executor gets this scoped token only.
MODEL_PROXY_URL=http://api:3001/internal/model
MODEL_PROXY_TOKEN=dev-model-proxy-token
MODEL_PROXY_TOKEN_ENV=MODEL_PROXY_TOKEN

EXECUTOR_CONCURRENCY=3

# M5: single-project closed loop. 3 x86 worker replicas are the default.
WORKER_REPLICAS=3
DISPATCHER_REPLICAS=2
# P0 command guard + automatic finding review.
COMMAND_GUARD_ENABLED=1
COMMAND_GUARD_MODE=llm
COMMAND_GUARD_FAIL_MODE=closed
COMMAND_GUARD_TIMEOUT_MS=8000
COMMAND_GUARD_BASE_URL=http://api:3001/internal/model/roles/guard
# Optional: command-review fallback endpoint/token; defaults to MISSION_API_URL + MODEL_PROXY_TOKEN.
# COMMAND_GUARD_APPROVAL_URL=
# COMMAND_GUARD_APPROVAL_TOKEN=
COMMAND_GUARD_MODEL=
FINDING_REVIEW_MODE=auto
SUMMARY_ENABLED=1
SUMMARY_MAX_ROUNDS=1
SUMMARY_MAX_STEPS=60
SUMMARY_WALL_CLOCK_MS=300000
SUMMARY_CREATE_TASKS=1

# Optional model key pool (comma/newline separated). Empty = use LLM_API_KEY.
LLM_API_KEYS=
LLM_KEY_COOLDOWN_MS=60000

# M5-4: dynamic cross-worker trace search through the internal API.
MISSION_API_URL=http://api:3001
# Set 0 to hide/disable the dynamic trace tool for A/B control arms.
WORKER_TRACE_SEARCH_ENABLED=1
# M5-1/3: project overview + per-claim mission context for read-only tools.
MISSION_CONTEXT_ENABLED=1
MISSION_CONTEXT_MAX_BYTES=524288
MISSION_BRIEF_MAX_CHARS=2500
# M5-2: planner concurrency (max open tasks) + frontier default on.
PLANNER_FRONTIER_ENABLED=1
PLANNER_PARALLEL_TASKS=3
PLANNER_MAX_OPEN_TASKS=3

# P3-B6 worker keepalive/storm guard (single key: no key pool)
WORKER_STORM_GUARD_THRESHOLD=4
WORKER_STORM_GUARD_BASE_MS=5000
WORKER_STORM_GUARD_MAX_MS=60000

# Isolated browser service (Playwright/Chromium).
BROWSER_SERVICE_TOKEN=dev-browser-token
REVERSE_SERVICE_TOKEN=dev-reverse-token
REVERSE_MAX_JOBS=2
REVERSE_JOB_TIMEOUT_SECONDS=600
SRC_AGENT_REVERSE_ENABLED=1
BROWSER_MAX_CONTEXTS=3
BROWSER_SESSION_TTL_MS=900000
BROWSER_EVAL_ENABLED=0
SRC_AGENT_BROWSER_ENABLED=1

# Mission artifact upload (APK/ELF/JS).
ARTIFACT_MAX_BYTES=2147483648

# IDA image build inputs (not runtime mounts).
# IDA_LICENSE_FILE=/absolute/path/to/idapro.hexlic
# IDA_HOME_DIR=/absolute/path/to/.idapro   # directory containing ida.reg (EULA accepted)

# Browser/reverse artifact TTL; use scripts/artifact-gc.mjs from a host cron.
ARTIFACT_TTL_DAYS=7

# Optional local-lab transport mapping. Example for a host-only target
# (the request/evidence Host remains 127.0.0.1:65280):
# PROXY_CONNECT_OVERRIDES=127.0.0.1:65280=host.docker.internal:65280


# ── v1.0.2 reliability hardening (ADR-0054) ─────────────────
# New behavior is opt-in except the observe-only watchdog; turn a flag off to
# return to v1.0.1 semantics without touching the additive migration.
V102_MISSION_DEADLINE=1
V102_TASK_DISPOSITION=1
V102_TASK_HANDOFF=0
V102_PREFLIGHT_STRICT=0
V102_RETRY_BACKOFF=0
V102_RETRY_BASE_MS=30000
V102_RETRY_MAX_MS=900000
V102_WATCHDOG_OBSERVE_ONLY=1
V102_SEARCH_GOVERNANCE=1
V102_PLANNER_COVERAGE_INVARIANT=0
V102_PLANNER_ROI=0
V102_REPORTING_ENDGAME=1
WATCHDOG_MODE=observe
